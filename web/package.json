{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@hono/node-server": "1.19.13",
    "postcss": "8.5.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "docker compose up -d --wait postgres",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "services:start": "docker compose up -d --build --wait postgres estimator",
    "services:stop": "docker compose down",
    "estimator:start": "docker compose up -d --build --wait estimator",
    "estimator:logs": "docker compose logs -f estimator",
    "db:setup": "npm run db:start && npm run db:push && npm run db:immutability && npm run db:generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:immutability": "prisma db execute --file prisma/immutability.sql",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify-seed": "tsx scripts/verify-seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "neighborhood:backfill": "tsx scripts/backfill-neighborhoods.ts",
    "validate": "npm run db:generate && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.23",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "@types/three": "^0.185.1",
    "ai": "^7.0.26",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-qr-code": "^2.2.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
