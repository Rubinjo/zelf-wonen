# Application and Better Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://houser:houser_dev_password@localhost:5432/houser?schema=public

# Brevo verification email delivery (without a key, local development logs links)
NEXT_PUBLIC_EMAIL_DELIVERY_MODE=webhook
EMAIL_DELIVERY_WEBHOOK_URL=https://api.brevo.com/v3/smtp/email
EMAIL_DELIVERY_TOKEN=
EMAIL_FROM_NAME="Redaxa Support"
EMAIL_FROM_ADDRESS=support@redaxa.nl

# OpenRouter (Vercel AI SDK via @openrouter/ai-sdk-provider; Auto Router "openrouter/auto")
OPENROUTER_API_KEY=

# Deterministic Python estimator
ML_ESTIMATOR_URL=http://localhost:8000
ML_ESTIMATOR_TOKEN=

# Media uses local disk; Docker persists uploads/private documents in named volumes.
# The estimator reads authorized photo bytes directly; no media base URL is needed.

# Inbound aggregator images (platform-controlled storage / CDN domain)
AGGREGATED_MEDIA_BASE_URL=/aggregated-media

# Property-data lookups

# Best-effort public single-address energy-label lookup
ENERGIELABEL_NL_API_BASE_URL=https://www.energielabel.nl/api/v1/

# Didit identity verification (sandbox keys for local development)
IDENTITY_VERIFICATION_TTL_DAYS=365
DIDIT_MODE=sandbox
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=


# Audit/privacy salts
IP_HASH_SALT=replace-with-an-independent-random-secret
