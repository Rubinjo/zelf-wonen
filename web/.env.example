# Application and Better Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://houser:houser_dev_password@localhost:5432/houser?schema=public

# Verification email delivery adapter
NEXT_PUBLIC_EMAIL_DELIVERY_MODE=webhook
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_TOKEN=

# OpenRouter (Vercel AI SDK via @openrouter/ai-sdk-provider; Auto Router "openrouter/auto")
OPENROUTER_API_KEY=

# Deterministic Python estimator
ML_ESTIMATOR_URL=http://localhost:8000
ML_ESTIMATOR_TOKEN=
EMERGENCY_PRICE_PER_SQM_CENTS=450000

# Private media resolution (replace public base with signed URL service in production)
OBJECT_STORAGE_MEDIA_BASE_URL=https://media.example.invalid/

# Inbound aggregator images (platform-controlled storage / CDN domain)
AGGREGATED_MEDIA_BASE_URL=/aggregated-media

# Official property-data ingestion
KADASTER_API_BASE_URL=
KADASTER_API_KEY=
EP_ONLINE_API_BASE_URL=
EP_ONLINE_API_KEY=

# Best-effort public single-address energy-label lookup
ENERGIELABEL_NL_API_BASE_URL=https://www.energielabel.nl/api/v1/

# Certified iDIN provider
IDIN_MODE=simulated
IDIN_PROVIDER_BASE_URL=
IDIN_MERCHANT_ID=
IDIN_SIGNING_KEY=
IDIN_CALLBACK_SECRET=

# Simulated direct-to-consumer publishing API
FUNDA_API_BASE_URL=https://funda-simulator.example.invalid
FUNDA_API_KEY=

# Audit/privacy salts and payment callbacks
IP_HASH_SALT=replace-with-an-independent-random-secret
PAYMENT_WEBHOOK_SECRET=
