{$APP_DOMAIN} {
    encode zstd gzip

    handle_path /aggregated-media/* {
        root * /srv/aggregated-media
        header X-Content-Type-Options nosniff
        header Cache-Control "public, max-age=86400"
        file_server {
            hide .upload-*
        }
    }

    handle_path /uploads/* {
        root * /srv/uploads
        header X-Content-Type-Options nosniff
        header Cache-Control "public, max-age=0, must-revalidate"
        file_server {
            hide .upload-*
        }
    }

    handle {
        reverse_proxy web:3000
    }
}
