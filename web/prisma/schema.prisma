generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  NL
  EN
}

enum ListingPurpose {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  READY_FOR_VERIFICATION
  LIVE
  UNDER_OFFER
  SOLD
  RENTED
  ARCHIVED
}

// Inbound aggregator enums. Aggregated listings are an informational discovery
// layer only: bidding, viewings and transactions always happen off-platform.
enum ListingSource {
  FUNDA
  KAMERNET
}

enum AggregatedListingStatus {
  ACTIVE
  EXPIRED
  OFFLINE
  ERROR
}

enum PropertyType {
  HOUSE
  APARTMENT
  PARKING
  LAND
  COMMERCIAL
  OTHER
}

enum RoofType {
  FLAT
  GABLE
  HIP
  MANSARD
  SHED
  COMBINATION
  OTHER
}

enum PropertyAmenity {
  SOLAR_PANELS
  AIR_CONDITIONING
  FIBER_OPTIC
  HEAT_PUMP
  EV_CHARGER
  FIREPLACE
  MECHANICAL_VENTILATION
  ALARM_SYSTEM
}

enum ParkingOption {
  ON_PROPERTY
  FREE_STREET
  PAID_STREET
  PARKING_PERMIT
  PUBLIC_GARAGE
  PRIVATE_GARAGE
  SPACE_FOR_SALE
}

enum ErfpachtType {
  // Niet ingevuld / onbekend
  UNKNOWN
  // Volle eigendom: geen erfpacht
  FREEHOLD
  // Erfpacht met een (jaarlijkse) canon
  LEASEHOLD
  // Erfpacht waarvan de canon (eenmalig) is afgekocht
  LEASEHOLD_AFGEKOCHT
}

enum FoundationRiskLevel {
  // Buiten een indicatief aandachtsgebied voor funderingsproblematiek (KCAF)
  NONE
  LOW
  MEDIUM
  HIGH
}

enum EnergyLabelClass {
  A_PLUS_PLUS_PLUS_PLUS_PLUS
  A_PLUS_PLUS_PLUS_PLUS
  A_PLUS_PLUS_PLUS
  A_PLUS_PLUS
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
  UNKNOWN
}

enum MediaKind {
  PHOTO
  FLOOR_PLAN_STATIC
  DOCUMENT
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
}

enum FloorPlanMode {
  STATIC_UPLOAD
  FLOORPLANNER_EMBED
}

enum VerificationKind {
  EMAIL
  IDIN
}

enum VerificationStatus {
  INITIATED
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  CANCELLED
}

enum VerificationPurpose {
  ACCOUNT_ACCESS
  LISTING_PUBLICATION
  EXTERNAL_PUBLICATION
  AGREEMENT_SIGNING
}

enum PublicationPackage {
  BRONZE
  SILVER
  GOLD
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PublicationChannel {
  PLATFORM
  FUNDA
}

enum PublicationStatus {
  QUEUED
  SUBMITTED
  LIVE
  REJECTED
  WITHDRAWN
  FAILED
}

enum BidEventType {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BiddingMethod {
  PRIVATE
  SEALED
  OPEN
}

enum EstimateTier {
  MULTIMODAL_ML
  BASIC_ML
  POSTCODE_SQM
}

enum ViewingType {
  APPOINTMENT
  OPEN_HOUSE
}

enum ViewingAttendanceStatus {
  SCHEDULED
  CONFIRMED
  NO_SHOW
}

enum TransactionStatus {
  ACTIVE
  CONTRACT_PENDING
  CONDITIONS_PENDING
  READY_FOR_TRANSFER
  COMPLETED
  CANCELLED
}

enum TransactionMilestoneType {
  PURCHASE_AGREEMENT
  COOLING_OFF_PERIOD
  FINANCING
  BUILDING_INSPECTION
  SECURITY_DEPOSIT
  NOTARY_SELECTION
  DEED_OF_TRANSFER
  FINAL_INSPECTION
  KEY_HANDOVER
}

enum TransactionMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  WAIVED
  OVERDUE
}

enum TransactionMessageKind {
  TEXT
  SYSTEM
}

enum TransactionDocumentCategory {
  CHAT_ATTACHMENT
  PURCHASE_AGREEMENT
  PROPERTY_PASSPORT
  FINANCING
  BUILDING_INSPECTION
  SECURITY_DEPOSIT
  NOTARY
  FINAL_INSPECTION
  // Woningpaspoort-documentcategorieën: leveren input voor de volledigheid
  // van het woningpaspoort en kunnen automatisch een nieuwe versie triggeren.
  ENERGY_LABEL
  FLOOR_PLAN
  VVE
  CADASTRAL
  OTHER
}

enum TransactionDocumentStatus {
  AVAILABLE
  SUPERSEDED
  DELETED
}

enum TransactionEventType {
  ROOM_CREATED
  MESSAGE_SENT
  // Berichten van vóór de koop zijn overgezet van de advertentie naar de transactiechat.
  MESSAGE_IMPORTED
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  MILESTONE_UPDATED
  CONTRACT_CONFIRMED
  AGREEMENT_UPDATED
  AGREEMENT_SUBMITTED
  AGREEMENT_SIGNED
  NOTARY_UPDATED
  HANDOVER_UPDATED
  PASSPORT_VERSION_CREATED
  SECURITY_FORM_CHOSEN
  SECURITY_REFERENCE_CREATED
  SECURITY_PAID
  SECURITY_CONFIRMED
  TRANSACTION_COMPLETED
  TRANSACTION_CANCELLED
}

enum PurchaseAgreementStatus {
  DRAFT
  AWAITING_SIGNATURES
  PARTIALLY_SIGNED
  SIGNED
  VOID
}

enum AgreementSecurityType {
  NONE
  // Zekerheid is vereist; de KOPER kiest de vorm (waarborgsom of bankgarantie,
  // Art 7:26 lid 4 BW). Bedrag en termijn worden door de verkoper vastgelegd.
  REQUIRED
}

// Keuze van de koper voor de vorm van zekerheid (Art 7:26 lid 4 BW).
enum TransactionSecurityForm {
  DEPOSIT
  BANK_GUARANTEE
}

enum SeekerNotificationType {
  NEW_LISTING
  PRICE_CHANGED
  LISTING_STATUS_CHANGED
  VIEWING_UPDATED
  BID_UPDATED
  TRANSACTION_UPDATED
  DEADLINE_APPROACHING
}

// Better Auth core model. Never store BSN or raw iDIN assertions on this record.
model User {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  image            String?
  locale           Locale   @default(NL)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions              Session[]
  accounts              Account[]
  twoFactors            TwoFactor[]
  properties            Property[]
  listings              Listing[]
  bids                  Bid[]
  identityAttempts      IdentityVerificationAttempt[]
  verificationAuditLogs VerificationAuditLog[]
  publicationOrders     PublicationOrder[]
  auditEvents           AuditEvent[]
  viewingBookings       ViewingBooking[]
  sellingTransactions   PropertyTransaction[] @relation("TransactionSeller")
  buyingTransactions    PropertyTransaction[] @relation("TransactionBuyer")
  proposedNotaries      PropertyTransaction[] @relation("TransactionNotaryProposer")
  confirmedNotaries     PropertyTransaction[] @relation("TransactionNotaryConfirmer")
  securityPayments      PropertyTransaction[] @relation("TransactionSecurityPayer")
  securityConfirmations PropertyTransaction[] @relation("TransactionSecurityConfirmer")
  securityFormChoices   PropertyTransaction[] @relation("TransactionSecurityFormChooser")
  transactionMessages   TransactionMessage[]
  transactionDocuments  TransactionDocument[]
  transactionEvents     TransactionEvent[]
  passportVersions      PropertyPassportVersion[]
  passportDrafts        PropertyPassportDraft[]
  favoriteListings      FavoriteListing[]
  savedSearches         SavedSearch[]
  notificationPreference NotificationPreference?
  seekerNotifications   SeekerNotification[]
  shortlistShares       ShortlistShare[]
  listingMessages       ListingMessage[]

  @@map("users")
}

// Encrypted TOTP secrets and one-time recovery codes are managed by Better Auth.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @db.Uuid
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Property {
  id                     String            @id @default(uuid()) @db.Uuid
  ownerId                String            @db.Uuid
  bagAddressId           String?
  bagBuildingId          String?
  cadastralParcelId      String?
  postcode               String            @db.VarChar(6)
  houseNumber            Int
  houseNumberAddition    String?
  street                 String
  city                   String
  municipality           String?
  province               String?
  latitude               Decimal?          @db.Decimal(9, 6)
  longitude              Decimal?          @db.Decimal(9, 6)
  propertyType           PropertyType
  livingAreaSqm          Decimal?          @db.Decimal(8, 2)
  officialLandAreaSqm    Decimal?          @db.Decimal(10, 2)
  volumeCubicMeters      Decimal?          @db.Decimal(10, 2)
  roomCount              Int?
  bedroomCount           Int?
  bathroomCount          Int?
  floorCount             Int?
  roofType               RoofType?
  externalStorageAreaSqm Decimal?          @db.Decimal(8, 2)
  amenities              PropertyAmenity[] @default([])
  parkingOptions         ParkingOption[]   @default([])
  parkingSpacePriceCents BigInt?
  constructionYear       Int?
  isMonument             Boolean           @default(false)
  erfpachtType           ErfpachtType      @default(UNKNOWN)
  erfpachtCanonCents     BigInt?
  erfpachtDetails        String?
  erfpachtEndDate        DateTime?
  erfpachtSource         String?
  erfpachtRetrievedAt    DateTime?
  layout                 Json?
  kadasterSourcePayload  Json?
  kadasterRetrievedAt    DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  owner                  User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  energyLabels           EnergyLabel[]
  neighborhoodProfile    NeighborhoodProfile?
  listings               Listing[]

  @@index([ownerId, bagAddressId])
  @@index([ownerId])
  @@index([erfpachtType])
  @@index([postcode, houseNumber, houseNumberAddition])
  @@map("properties")
}

model NeighborhoodProfile {
  id                           String   @id @default(uuid()) @db.Uuid
  propertyId                   String   @unique @db.Uuid
  neighborhoodCode             String   @db.VarChar(10)
  neighborhoodName             String
  districtCode                 String?  @db.VarChar(8)
  districtName                 String?
  municipalityCode             String   @db.VarChar(6)
  statisticsYear               Int
  population                   Int?
  populationDensityPerKm2      Int?
  nationalPopulationDensityPerKm2 Int?
  age0To14Percent              Decimal? @db.Decimal(5, 2)
  age15To24Percent             Decimal? @db.Decimal(5, 2)
  age25To44Percent             Decimal? @db.Decimal(5, 2)
  age45To64Percent             Decimal? @db.Decimal(5, 2)
  age65PlusPercent             Decimal? @db.Decimal(5, 2)
  nationalAge0To14Percent      Decimal? @db.Decimal(5, 2)
  nationalAge15To24Percent     Decimal? @db.Decimal(5, 2)
  nationalAge25To44Percent     Decimal? @db.Decimal(5, 2)
  nationalAge45To64Percent     Decimal? @db.Decimal(5, 2)
  nationalAge65PlusPercent     Decimal? @db.Decimal(5, 2)
  housingCorporationPercent    Decimal? @db.Decimal(5, 2)
  nationalHousingCorporationPercent Decimal? @db.Decimal(5, 2)
  registeredCrimesPer1000      Decimal? @db.Decimal(8, 2)
  nationalRegisteredCrimesPer1000 Decimal? @db.Decimal(8, 2)
  crimeStatisticsYear          Int?
  supermarketDistanceKm        Decimal? @db.Decimal(6, 2)
  primarySchoolDistanceKm      Decimal? @db.Decimal(6, 2)
  daycareDistanceKm            Decimal? @db.Decimal(6, 2)
  generalPracticeDistanceKm    Decimal? @db.Decimal(6, 2)
  primarySchoolsWithin3Km      Decimal? @db.Decimal(6, 1)
  supermarketsWithin1Km        Int?
  schoolsWithin1Km             Int?
  busStopDistanceMeters        Int?
  tramStopDistanceMeters       Int?
  metroStationDistanceMeters   Int?
  trainStationDistanceMeters   Int?
  // ---- Geluid: jaargemiddelde geluidsbelasting (Lden) per bron ----
  noiseRoadLden                Decimal? @db.Decimal(5, 1)
  noiseRailLden                Decimal? @db.Decimal(5, 1)
  noiseIndustryLden            Decimal? @db.Decimal(5, 1)
  noiseAircraftLden            Decimal? @db.Decimal(5, 1)
  noiseGridMeters              Int?
  noiseSource                  String?
  noiseRetrievedAt             DateTime?
  // ---- Funderingsrisico (indicatief, KCAF/PDOK + BAG) ----
  foundationRiskLevel          FoundationRiskLevel?
  foundationRiskAreaShare      Decimal? @db.Decimal(5, 1)
  foundationPre1970Percent     Decimal? @db.Decimal(5, 1)
  foundationGroundClass        String?
  foundationRiskDetail         String?
  foundationRiskSource         String?
  foundationRiskRetrievedAt    DateTime?
  // ---- Samenstelling: geslacht, huishouden, opleiding ----
  malePercent                  Decimal? @db.Decimal(5, 2)
  femalePercent                Decimal? @db.Decimal(5, 2)
  averageHouseholdSize         Decimal? @db.Decimal(4, 2)
  singleHouseholdPercent       Decimal? @db.Decimal(5, 2)
  coupleHouseholdPercent       Decimal? @db.Decimal(5, 2)
  familyHouseholdPercent       Decimal? @db.Decimal(5, 2)
  educationLowPercent          Decimal? @db.Decimal(5, 2)
  educationMediumPercent       Decimal? @db.Decimal(5, 2)
  educationHighPercent         Decimal? @db.Decimal(5, 2)
  educationStatisticsYear      Int?
  demographicsSourceUrl        String?
  demographicsRetrievedAt      DateTime?
  cbsDataset                   String
  cbsSourceUrl                 String
  cbsRetrievedAt               DateTime
  crimeDataset                 String?
  crimeSourceUrl               String?
  osmSourceUrl                 String?
  osmRetrievedAt               DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  property                     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([neighborhoodCode])
  @@index([housingCorporationPercent])
  @@index([registeredCrimesPer1000])
  @@index([supermarketDistanceKm])
  @@index([primarySchoolDistanceKm])
  @@index([busStopDistanceMeters])
  @@index([trainStationDistanceMeters])
  @@map("neighborhood_profiles")
}

model EnergyLabel {
  id                            String           @id @default(uuid()) @db.Uuid
  propertyId                    String           @db.Uuid
  registrationNumber            String?
  labelClass                    EnergyLabelClass
  primaryFossilEnergyKwhSqmYear Decimal?         @db.Decimal(10, 2)
  registeredAt                  DateTime?
  validUntil                    DateTime?
  source                        String           @default("RVO_EP_ONLINE")
  sourcePayload                 Json?
  retrievedAt                   DateTime         @default(now())
  property                      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, registeredAt])
  @@index([registrationNumber])
  @@map("energy_labels")
}

model Listing {
  id                     String                        @id @default(uuid()) @db.Uuid
  ownerId                String                        @db.Uuid
  propertyId             String                        @db.Uuid
  purpose                ListingPurpose
  status                 ListingStatus                 @default(DRAFT)
  publicSlug             String?                       @unique
  titleNl                String?
  titleEn                String?
  descriptionNl          String?
  descriptionEn          String?
  askingPriceCents       BigInt?
  monthlyRentCents       BigInt?
  serviceCostsCents      BigInt?
  availableFrom          DateTime?
  viewingNotes           String?
  attributes             Json?
  biddingMethod          BiddingMethod                 @default(PRIVATE)
  minimumBidCents        BigInt?
  bidIncrementCents      BigInt?
  allowBidConditions     Boolean                       @default(true)
  bidWindowOpensAt       DateTime?
  bidWindowClosesAt      DateTime?
  validatedAt            DateTime?
  publicationRequestedAt DateTime?
  liveAt                 DateTime?
  finalizedAt            DateTime?
  version                Int                           @default(1)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  owner                  User                          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  property               Property                      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  media                  ListingMedia[]
  floorPlans             FloorPlan[]
  bids                   Bid[]
  publicationOrders      PublicationOrder[]
  publications           ListingPublication[]
  identityAttempts       IdentityVerificationAttempt[]
  logbookExports         BidLogbookExport[]
  auditEvents            AuditEvent[]
  viewingSlots           ViewingSlot[]
  transactions           PropertyTransaction[]
  passportVersions       PropertyPassportVersion[]
  passportDraft          PropertyPassportDraft?
  favoritedBy            FavoriteListing[]
  shortlistItems         ShortlistItem[]
  listingMessages        ListingMessage[]

  @@index([ownerId, status])
  @@index([propertyId])
  @@map("listings")
}

model ViewingSlot {
  id           String           @id @default(uuid()) @db.Uuid
  listingId    String           @db.Uuid
  type         ViewingType      @default(APPOINTMENT)
  startsAt     DateTime
  endsAt       DateTime
  publishedAt  DateTime         @default(now())
  capacity     Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings     ViewingBooking[]

  @@index([listingId, publishedAt, startsAt])
  @@map("viewing_slots")
}

model ViewingBooking {
  id               String                  @id @default(uuid()) @db.Uuid
  slotId           String                  @db.Uuid
  userId           String                  @db.Uuid
  attendanceStatus ViewingAttendanceStatus @default(SCHEDULED)
  ownerReviewedAt  DateTime?
  createdAt        DateTime                @default(now())
  slot             ViewingSlot             @relation(fields: [slotId], references: [id], onDelete: Restrict)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([slotId, userId])
  @@index([userId, createdAt])
  @@index([userId, attendanceStatus])
  @@map("viewing_bookings")
}

model ListingMedia {
  id          String      @id @default(uuid()) @db.Uuid
  listingId   String      @db.Uuid
  kind        MediaKind
  status      MediaStatus @default(PENDING_UPLOAD)
  storageKey  String      @unique
  mimeType    String
  sha256      String      @db.Char(64)
  fileName    String
  sizeBytes   BigInt
  width       Int?
  height      Int?
  sortOrder   Int         @default(0)
  altTextNl   String?
  altTextEn   String?
  processedAt DateTime?
  createdAt   DateTime    @default(now())
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, kind, sortOrder])
  @@map("listing_media")
}

model FloorPlan {
  id                    String        @id @default(uuid()) @db.Uuid
  listingId             String        @db.Uuid
  mode                  FloorPlanMode
  floorName             String?
  floorplannerProjectId String?
  embedUrl              String?
  staticMediaId         String?       @db.Uuid
  sortOrder             Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  listing               Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("floor_plans")
}

model IdentityVerificationAttempt {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @db.Uuid
  listingId            String?             @db.Uuid
  transactionId        String?             @db.Uuid
  purpose              VerificationPurpose
  provider             String
  providerReference    String              @unique
  status               VerificationStatus  @default(INITIATED)
  subjectReferenceHash String?             @db.Char(64)
  attributesMatched    Json?
  requestedAt          DateTime            @default(now())
  completedAt          DateTime?
  expiresAt            DateTime?
  failureCode          String?
  responsePayloadHash  String?             @db.Char(64)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing              Listing?            @relation(fields: [listingId], references: [id], onDelete: Restrict)
  transaction          PropertyTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([userId, status, completedAt])
  @@index([listingId, purpose, status])
  @@index([transactionId, purpose, status])
  @@map("identity_verification_attempts")
}

model VerificationAuditLog {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  kind              VerificationKind
  status            VerificationStatus
  purpose           VerificationPurpose
  provider          String
  providerReference String?
  metadata          Json?
  occurredAt        DateTime            @default(now())
  previousHash      String?             @db.Char(64)
  entryHash         String              @unique @db.Char(64)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, kind, occurredAt])
  @@map("verification_audit_logs")
}

model PublicationOrder {
  id               String               @id @default(uuid()) @db.Uuid
  listingId        String               @db.Uuid
  userId           String               @db.Uuid
  package          PublicationPackage
  status           OrderStatus          @default(CREATED)
  amountCents      BigInt
  currency         String               @default("EUR") @db.Char(3)
  paymentProvider  String?
  paymentReference String?              @unique
  paidAt           DateTime?
  consumedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  listing          Listing              @relation(fields: [listingId], references: [id], onDelete: Restrict)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  publications     ListingPublication[]

  @@index([listingId, status])
  @@index([userId, createdAt])
  @@map("publication_orders")
}

model ListingPublication {
  id                  String              @id @default(uuid()) @db.Uuid
  listingId           String              @db.Uuid
  orderId             String?             @db.Uuid
  idempotencyKey      String              @unique
  channel             PublicationChannel
  status              PublicationStatus   @default(QUEUED)
  package             PublicationPackage?
  externalReference   String?
  requestPayloadHash  String?             @db.Char(64)
  responsePayloadHash String?             @db.Char(64)
  submittedAt         DateTime?
  liveAt              DateTime?
  failedAt            DateTime?
  failureCode         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  listing             Listing             @relation(fields: [listingId], references: [id], onDelete: Restrict)
  order               PublicationOrder?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([channel, externalReference])
  @@index([listingId, channel, status])
  @@map("listing_publications")
}

// Bid rows and events are append-only. PostgreSQL triggers in immutability.sql enforce this.
model Bid {
  id                    String     @id @default(uuid()) @db.Uuid
  listingId             String     @db.Uuid
  bidderUserId          String?    @db.Uuid
  idempotencyKey        String     @unique
  bidderPseudonym       String
  amountCents           BigInt
  currency              String     @default("EUR") @db.Char(3)
  resolutiveConditions  Json
  financingDeadline     DateTime?
  transferDateRequested DateTime?
  submittedAt           DateTime   @default(now())
  sourceIpHash          String?    @db.Char(64)
  previousHash          String?    @db.Char(64)
  entryHash             String     @unique @db.Char(64)
  listing               Listing    @relation(fields: [listingId], references: [id], onDelete: Restrict)
  bidderUser            User?      @relation(fields: [bidderUserId], references: [id], onDelete: SetNull)
  events                BidEvent[]
  transaction           PropertyTransaction?

  @@index([listingId, submittedAt])
  @@index([bidderUserId])
  @@map("bids")
}

model BidEvent {
  id           String       @id @default(uuid()) @db.Uuid
  bidId        String       @db.Uuid
  type         BidEventType
  reason       String?
  occurredAt   DateTime     @default(now())
  previousHash String?      @db.Char(64)
  entryHash    String       @unique @db.Char(64)
  bid          Bid          @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@index([bidId, occurredAt])
  @@map("bid_events")
}

model BidLogbookExport {
  id                   String    @id @default(uuid()) @db.Uuid
  listingId            String    @db.Uuid
  storageKey           String    @unique
  documentSha256       String    @db.Char(64)
  logbookHeadHash      String    @db.Char(64)
  anonymizationVersion String
  generatedAt          DateTime  @default(now())
  sharedAt             DateTime?
  recipientCount       Int       @default(0)
  listing              Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId, generatedAt])
  @@map("bid_logbook_exports")
}

model PropertyTransaction {
  id                        String            @id @default(uuid()) @db.Uuid
  listingId                 String            @db.Uuid
  acceptedBidId             String            @unique @db.Uuid
  sellerUserId              String            @db.Uuid
  buyerUserId               String            @db.Uuid
  status                    TransactionStatus @default(ACTIVE)
  purchasePriceCents        BigInt
  currency                  String            @default("EUR") @db.Char(3)
  targetTransferDate        DateTime?
  contractTerms             Json?
  buyerContractConfirmedAt  DateTime?
  sellerContractConfirmedAt DateTime?
  coolingOffEndsAt          DateTime?
  // Notaris: de verkoper mag alleen voorstellen, de koper bevestigt.
  notaryProposal            Json?
  notaryProposedByUserId    String?            @db.Uuid
  notaryProposedAt          DateTime?
  notaryDetails             Json?
  notaryConfirmedByUserId   String?            @db.Uuid
  notaryConfirmedAt         DateTime?
  handoverDetails           Json?
  // Waarborgsom (Art 7:26 lid 4 BW): beheer zonder zelf geld aan te houden.
  // De storting loopt via de kwaliteitsrekening van de notaris; het platform
  // coördineert en registreert uitsluitend de status (geen depot bij platform).
  // De koper kiest de vorm (waarborgsom of bankgarantie); de verkoper bepaalt
  // op de koopovereenkomst alleen of zekerheid vereist is (REQUIRED).
  securityForm               TransactionSecurityForm?
  securityFormChosenAt       DateTime?
  securityFormChosenByUserId String?             @db.Uuid
  securityReference          String?
  securityPaidAt             DateTime?
  securityPaidByUserId       String?             @db.Uuid
  securityConfirmedAt        DateTime?
  securityConfirmedByUserId  String?             @db.Uuid
  completedAt                DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?
  version                   Int               @default(1)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  listing                   Listing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  acceptedBid               Bid               @relation(fields: [acceptedBidId], references: [id], onDelete: Restrict)
  seller                    User              @relation("TransactionSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  buyer                     User              @relation("TransactionBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  notaryProposedBy          User?             @relation("TransactionNotaryProposer", fields: [notaryProposedByUserId], references: [id], onDelete: SetNull)
  notaryConfirmedBy         User?             @relation("TransactionNotaryConfirmer", fields: [notaryConfirmedByUserId], references: [id], onDelete: SetNull)
  securityPaidBy            User?             @relation("TransactionSecurityPayer", fields: [securityPaidByUserId], references: [id], onDelete: SetNull)
  securityConfirmedBy       User?             @relation("TransactionSecurityConfirmer", fields: [securityConfirmedByUserId], references: [id], onDelete: SetNull)
  securityFormChosenBy      User?             @relation("TransactionSecurityFormChooser", fields: [securityFormChosenByUserId], references: [id], onDelete: SetNull)
  milestones                TransactionMilestone[]
  messages                  TransactionMessage[]
  documents                 TransactionDocument[]
  events                    TransactionEvent[]
  agreement                 PurchaseAgreement?
  idinAttempts              IdentityVerificationAttempt[]
  importedListingMessages   ListingMessage[]

  @@index([sellerUserId, status, updatedAt])
  @@index([buyerUserId, status, updatedAt])
  @@index([listingId, status])
  @@map("property_transactions")
}

// Gestructureerde koopovereenkomst (bestaande woning, Art 7:2 BW).
// Alleen voor SALE-transacties; voor verhuur blijft het bestaande contractTerms-flow bestaan.
// De termen in "TermWeeks"/"TermDays" lopen vanaf ondertekening; absolute deadlinedatums
// worden bij ondertekening berekend en op de milestones gekopieerd.
model PurchaseAgreement {
  id            String                  @id @default(uuid()) @db.Uuid
  transactionId String                  @unique @db.Uuid
  version       Int                     @default(1)
  status        PurchaseAgreementStatus @default(DRAFT)

  // Partijen (Art 7:2 BW; echtgenoot/partner-instemming Art 1:88 BW)
  sellerCivilStatus     String?
  sellerAddress         String?
  sellerSpouseName      String?
  sellerSpouseConsentAt DateTime?
  buyerCivilStatus      String?
  buyerAddress          String?
  buyerSpouseName       String?
  buyerSpouseConsentAt  DateTime?

  // Object en prijs (roerende zaken + toegerekende waarde)
  kadastraleOmschrijving String?
  movables               Json?  // [{ description, valueCents }]
  movablesValueCents     BigInt?

  // Waarborgsom / bankgarantie (max 10% van koopsom, Art 7:26 lid 4 BW).
  // De koper kiest de vorm (waarborgsom of bankgarantie) na ondertekening.
  securityType        AgreementSecurityType @default(REQUIRED)
  securityAmountCents BigInt?
  securityDueDate     DateTime?

  // Ontbindende voorwaarden (termen vanaf ondertekening)
  financingCondition     Boolean @default(true)
  financingTermWeeks     Int     @default(6)
  inspectionCondition    Boolean @default(false)
  inspectionTermDays     Int     @default(14)
  inspectionCostCapCents BigInt?
  nhgCondition           Boolean @default(false)
  nhgTermWeeks           Int     @default(8)
  foundationCondition    Boolean @default(false)
  foundationTermWeeks    Int     @default(4)

  // Levering en kosten
  transferDate         DateTime?
  kadasterRegistration Boolean @default(true)
  buyerPaysCosts       Boolean @default(true)

  // Overige afspraken (aanvullend op de modelbepalingen)
  additionalTerms String?

  // Bedenktijd (Art 7:2 lid 2 BW): langer mag, korter niet
  coolingOffDays Int @default(3)

  // Berekende deadlines (ingevuld bij ondertekening)
  financingDeadline  DateTime?
  inspectionDeadline DateTime?
  nhgDeadline        DateTime?
  foundationDeadline DateTime?
  coolingOffEndsAt   DateTime?

  // Ondertekening (uitsluitend via iDIN-geverifieerde handtekening)
  sellerSignedAt        DateTime?
  sellerSignatureMethod String?
  sellerSignatureEvidence Json?
  buyerSignedAt         DateTime?
  buyerSignatureMethod  String?
  buyerSignatureEvidence Json?

  submittedAt DateTime?
  signedAt    DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transaction PropertyTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, status])
  @@map("purchase_agreements")
}

model TransactionMilestone {
  id            String                       @id @default(uuid()) @db.Uuid
  transactionId String                       @db.Uuid
  type          TransactionMilestoneType
  status        TransactionMilestoneStatus   @default(NOT_STARTED)
  title         String
  dueAt         DateTime?
  completedAt   DateTime?
  details       Json?
  sortOrder     Int                          @default(0)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  transaction   PropertyTransaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, type])
  @@index([transactionId, sortOrder])
  @@index([dueAt, status])
  @@map("transaction_milestones")
}

model TransactionMessage {
  id            String                 @id @default(uuid()) @db.Uuid
  transactionId String                 @db.Uuid
  authorUserId  String                 @db.Uuid
  kind          TransactionMessageKind @default(TEXT)
  body          String
  createdAt     DateTime               @default(now())
  editedAt      DateTime?
  transaction   PropertyTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  author        User                   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  documents     TransactionDocument[]

  @@index([transactionId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("transaction_messages")
}

model TransactionDocument {
  id            String                      @id @default(uuid()) @db.Uuid
  transactionId String                      @db.Uuid
  messageId     String?                     @db.Uuid
  uploadedById  String                      @db.Uuid
  category      TransactionDocumentCategory @default(OTHER)
  status        TransactionDocumentStatus   @default(AVAILABLE)
  storageKey    String                      @unique
  mimeType      String
  sha256        String                      @db.Char(64)
  fileName      String
  sizeBytes     BigInt
  version       Int                         @default(1)
  createdAt     DateTime                    @default(now())
  transaction   PropertyTransaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  message       TransactionMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy    User                        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([transactionId, category, createdAt])
  @@index([messageId])
  @@map("transaction_documents")
}

