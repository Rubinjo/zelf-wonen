// Bewerkbare (mutable) werkomgeving van het woningpaspoort per listing.
// Versies (PropertyPassportVersion) zijn onveranderlijke momentopnamen van
// deze draft + listing + documenten; de draft kan door de eigenaar worden
// bewerkt zonder de hash-keten aan te tasten.
model PropertyPassportDraft {
  id              String   @id @default(uuid()) @db.Uuid
  listingId       String   @unique @db.Uuid
  fields          Json
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("property_passport_drafts")
}

model TransactionEvent {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @db.Uuid
  actorUserId   String?              @db.Uuid
  type          TransactionEventType
  payload       Json?
  occurredAt    DateTime             @default(now())
