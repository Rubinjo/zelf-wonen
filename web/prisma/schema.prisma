// Berichten tussen woningzoekers en eigenaren binnen het platform.
// Elke woningzoeker heeft een eigen, afgeschermde berichtenlijn met de
// eigenaar (seekerUserId = de woningzoeker). De eigenaar kan op zijn
// advertentie meerdere gesprekken tegelijk voeren. Bij acceptatie van een
// bod worden de berichten van die specifieke zoeker overgezet naar de
// transactiechat (zie transferListingMessagesToTransaction).
model ListingMessage {
  id                         String             @id @default(uuid()) @db.Uuid
  listingId                  String             @db.Uuid
  authorUserId               String             @db.Uuid
  // De woningzoeker voor wie deze berichtenlijn geldt (niet de eigenaar).
  seekerUserId               String             @db.Uuid
  body                       String
  readAt                     DateTime?
  transferredToTransactionId String?            @db.Uuid
  transferredAt              DateTime?
  createdAt                  DateTime           @default(now())
  listing                    Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author                     User               @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  transferredToTransaction   PropertyTransaction? @relation(fields: [transferredToTransactionId], references: [id], onDelete: SetNull)

  @@index([listingId, seekerUserId, createdAt])
  @@index([seekerUserId, createdAt])
  @@index([transferredToTransactionId])
  @@map("listing_messages")
}

