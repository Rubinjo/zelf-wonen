generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  NL
  EN
}

enum ListingPurpose {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  READY_FOR_VERIFICATION
  LIVE
  UNDER_OFFER
  SOLD
  RENTED
  ARCHIVED
}

enum PropertyType {
  HOUSE
  APARTMENT
  PARKING
  LAND
  COMMERCIAL
  OTHER
}

enum RoofType {
  FLAT
  GABLE
  HIP
  MANSARD
  SHED
  COMBINATION
  OTHER
}

enum PropertyAmenity {
  SOLAR_PANELS
  AIR_CONDITIONING
  FIBER_OPTIC
  HEAT_PUMP
  EV_CHARGER
  FIREPLACE
  MECHANICAL_VENTILATION
  ALARM_SYSTEM
}

enum ParkingOption {
  ON_PROPERTY
  FREE_STREET
  PAID_STREET
  PARKING_PERMIT
  PUBLIC_GARAGE
  PRIVATE_GARAGE
  SPACE_FOR_SALE
}

enum EnergyLabelClass {
  A_PLUS_PLUS_PLUS_PLUS_PLUS
  A_PLUS_PLUS_PLUS_PLUS
  A_PLUS_PLUS_PLUS
  A_PLUS_PLUS
  A_PLUS
  A
  B
  C
  D
  E
  F
  G
  UNKNOWN
}

enum MediaKind {
  PHOTO
  FLOOR_PLAN_STATIC
  DOCUMENT
}

enum MediaStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  REJECTED
}

enum FloorPlanMode {
  STATIC_UPLOAD
  FLOORPLANNER_EMBED
}

enum VerificationKind {
  EMAIL
  IDIN
}

enum VerificationStatus {
  INITIATED
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  CANCELLED
}

enum VerificationPurpose {
  ACCOUNT_ACCESS
  LISTING_PUBLICATION
  EXTERNAL_PUBLICATION
}

enum PublicationPackage {
  BRONZE
  SILVER
  GOLD
}

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PublicationChannel {
  PLATFORM
  FUNDA
}

enum PublicationStatus {
  QUEUED
  SUBMITTED
  LIVE
  REJECTED
  WITHDRAWN
  FAILED
}

enum BidEventType {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BiddingMethod {
  PRIVATE
  SEALED
  OPEN
}

enum EstimateTier {
  MULTIMODAL_ML
  BASIC_ML
  POSTCODE_SQM
}

enum ViewingType {
  APPOINTMENT
  OPEN_HOUSE
}

enum ViewingAttendanceStatus {
  SCHEDULED
  CONFIRMED
  NO_SHOW
}

enum TransactionStatus {
  ACTIVE
  CONTRACT_PENDING
  CONDITIONS_PENDING
  READY_FOR_TRANSFER
  COMPLETED
  CANCELLED
}

enum TransactionMilestoneType {
  PURCHASE_AGREEMENT
  COOLING_OFF_PERIOD
  FINANCING
  BUILDING_INSPECTION
  SECURITY_DEPOSIT
  NOTARY_SELECTION
  DEED_OF_TRANSFER
  FINAL_INSPECTION
  KEY_HANDOVER
}

enum TransactionMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  WAIVED
  OVERDUE
}

enum TransactionMessageKind {
  TEXT
  SYSTEM
}

enum TransactionDocumentCategory {
  CHAT_ATTACHMENT
  PURCHASE_AGREEMENT
  PROPERTY_PASSPORT
  FINANCING
  BUILDING_INSPECTION
  NOTARY
  FINAL_INSPECTION
  OTHER
}

enum TransactionDocumentStatus {
  AVAILABLE
  SUPERSEDED
  DELETED
}

enum TransactionEventType {
  ROOM_CREATED
  MESSAGE_SENT
  DOCUMENT_UPLOADED
  DOCUMENT_DOWNLOADED
  MILESTONE_UPDATED
  CONTRACT_CONFIRMED
  NOTARY_UPDATED
  HANDOVER_UPDATED
  PASSPORT_VERSION_CREATED
  TRANSACTION_COMPLETED
  TRANSACTION_CANCELLED
}

enum SeekerNotificationType {
  NEW_LISTING
  PRICE_CHANGED
  LISTING_STATUS_CHANGED
  VIEWING_UPDATED
  BID_UPDATED
  TRANSACTION_UPDATED
  DEADLINE_APPROACHING
}

// Better Auth core model. Never store BSN or raw iDIN assertions on this record.
model User {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false)
  twoFactorEnabled Boolean  @default(false)
  image            String?
  locale           Locale   @default(NL)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions              Session[]
  accounts              Account[]
  twoFactors            TwoFactor[]
  properties            Property[]
  listings              Listing[]
  bids                  Bid[]
  identityAttempts      IdentityVerificationAttempt[]
  verificationAuditLogs VerificationAuditLog[]
  publicationOrders     PublicationOrder[]
  auditEvents           AuditEvent[]
  viewingBookings       ViewingBooking[]
  sellingTransactions   PropertyTransaction[] @relation("TransactionSeller")
  buyingTransactions    PropertyTransaction[] @relation("TransactionBuyer")
  transactionMessages   TransactionMessage[]
  transactionDocuments  TransactionDocument[]
  transactionEvents     TransactionEvent[]
  passportVersions      PropertyPassportVersion[]
  favoriteListings      FavoriteListing[]
  savedSearches         SavedSearch[]
  notificationPreference NotificationPreference?
  seekerNotifications   SeekerNotification[]
  shortlistShares       ShortlistShare[]

  @@map("users")
}

// Encrypted TOTP secrets and one-time recovery codes are managed by Better Auth.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @db.Uuid
  secret                  String
  backupCodes             String
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factors")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Property {
  id                     String            @id @default(uuid()) @db.Uuid
  ownerId                String            @db.Uuid
  bagAddressId           String?
  bagBuildingId          String?
  cadastralParcelId      String?
  postcode               String            @db.VarChar(6)
  houseNumber            Int
  houseNumberAddition    String?
  street                 String
  city                   String
  municipality           String?
  province               String?
  latitude               Decimal?          @db.Decimal(9, 6)
  longitude              Decimal?          @db.Decimal(9, 6)
  propertyType           PropertyType
  livingAreaSqm          Decimal?          @db.Decimal(8, 2)
  officialLandAreaSqm    Decimal?          @db.Decimal(10, 2)
  volumeCubicMeters      Decimal?          @db.Decimal(10, 2)
  roomCount              Int?
  bedroomCount           Int?
  bathroomCount          Int?
  floorCount             Int?
  roofType               RoofType?
  externalStorageAreaSqm Decimal?          @db.Decimal(8, 2)
  amenities              PropertyAmenity[] @default([])
  parkingOptions         ParkingOption[]   @default([])
  parkingSpacePriceCents BigInt?
  constructionYear       Int?
  isMonument             Boolean           @default(false)
  layout                 Json?
  kadasterSourcePayload  Json?
  kadasterRetrievedAt    DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  owner                  User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  energyLabels           EnergyLabel[]
  listings               Listing[]

  @@index([ownerId, bagAddressId])
  @@index([ownerId])
  @@index([postcode, houseNumber, houseNumberAddition])
  @@map("properties")
}

model EnergyLabel {
  id                            String           @id @default(uuid()) @db.Uuid
  propertyId                    String           @db.Uuid
  registrationNumber            String?
  labelClass                    EnergyLabelClass
  primaryFossilEnergyKwhSqmYear Decimal?         @db.Decimal(10, 2)
  registeredAt                  DateTime?
  validUntil                    DateTime?
  source                        String           @default("RVO_EP_ONLINE")
  sourcePayload                 Json?
  retrievedAt                   DateTime         @default(now())
  property                      Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, registeredAt])
  @@index([registrationNumber])
  @@map("energy_labels")
}

model Listing {
  id                     String                        @id @default(uuid()) @db.Uuid
  ownerId                String                        @db.Uuid
  propertyId             String                        @db.Uuid
  purpose                ListingPurpose
  status                 ListingStatus                 @default(DRAFT)
  publicSlug             String?                       @unique
  titleNl                String?
  titleEn                String?
  descriptionNl          String?
  descriptionEn          String?
  askingPriceCents       BigInt?
  monthlyRentCents       BigInt?
  serviceCostsCents      BigInt?
  availableFrom          DateTime?
  viewingNotes           String?
  attributes             Json?
  biddingMethod          BiddingMethod                 @default(PRIVATE)
  minimumBidCents        BigInt?
  bidIncrementCents      BigInt?
  allowBidConditions     Boolean                       @default(true)
  bidWindowOpensAt       DateTime?
  bidWindowClosesAt      DateTime?
  validatedAt            DateTime?
  publicationRequestedAt DateTime?
  liveAt                 DateTime?
  finalizedAt            DateTime?
  version                Int                           @default(1)
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  owner                  User                          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  property               Property                      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  media                  ListingMedia[]
  floorPlans             FloorPlan[]
  bids                   Bid[]
  publicationOrders      PublicationOrder[]
  publications           ListingPublication[]
  identityAttempts       IdentityVerificationAttempt[]
  logbookExports         BidLogbookExport[]
  auditEvents            AuditEvent[]
  viewingSlots           ViewingSlot[]
  transactions           PropertyTransaction[]
  passportVersions       PropertyPassportVersion[]
  favoritedBy            FavoriteListing[]
  shortlistItems         ShortlistItem[]

  @@index([ownerId, status])
  @@index([propertyId])
  @@map("listings")
}

model ViewingSlot {
  id           String           @id @default(uuid()) @db.Uuid
  listingId    String           @db.Uuid
  type         ViewingType      @default(APPOINTMENT)
  startsAt     DateTime
  endsAt       DateTime
  publishedAt  DateTime         @default(now())
  capacity     Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bookings     ViewingBooking[]

  @@index([listingId, publishedAt, startsAt])
  @@map("viewing_slots")
}

model ViewingBooking {
  id               String                  @id @default(uuid()) @db.Uuid
  slotId           String                  @db.Uuid
  userId           String                  @db.Uuid
  attendanceStatus ViewingAttendanceStatus @default(SCHEDULED)
  ownerReviewedAt  DateTime?
  createdAt        DateTime                @default(now())
  slot             ViewingSlot             @relation(fields: [slotId], references: [id], onDelete: Restrict)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([slotId, userId])
  @@index([userId, createdAt])
  @@index([userId, attendanceStatus])
  @@map("viewing_bookings")
}

model ListingMedia {
  id          String      @id @default(uuid()) @db.Uuid
  listingId   String      @db.Uuid
  kind        MediaKind
  status      MediaStatus @default(PENDING_UPLOAD)
  storageKey  String      @unique
  mimeType    String
  sha256      String      @db.Char(64)
  fileName    String
  sizeBytes   BigInt
  width       Int?
  height      Int?
  sortOrder   Int         @default(0)
  altTextNl   String?
  altTextEn   String?
  processedAt DateTime?
  createdAt   DateTime    @default(now())
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, kind, sortOrder])
  @@map("listing_media")
}

model FloorPlan {
  id                    String        @id @default(uuid()) @db.Uuid
  listingId             String        @db.Uuid
  mode                  FloorPlanMode
  floorName             String?
  floorplannerProjectId String?
  embedUrl              String?
  staticMediaId         String?       @db.Uuid
  sortOrder             Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  listing               Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("floor_plans")
}

model IdentityVerificationAttempt {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @db.Uuid
  listingId            String?             @db.Uuid
  purpose              VerificationPurpose
  provider             String
  providerReference    String              @unique
  status               VerificationStatus  @default(INITIATED)
  subjectReferenceHash String?             @db.Char(64)
  attributesMatched    Json?
  requestedAt          DateTime            @default(now())
  completedAt          DateTime?
  expiresAt            DateTime?
  failureCode          String?
  responsePayloadHash  String?             @db.Char(64)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing              Listing?            @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([userId, status, completedAt])
  @@index([listingId, purpose, status])
  @@map("identity_verification_attempts")
}

model VerificationAuditLog {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @db.Uuid
  kind              VerificationKind
  status            VerificationStatus
  purpose           VerificationPurpose
  provider          String
  providerReference String?
  metadata          Json?
  occurredAt        DateTime            @default(now())
  previousHash      String?             @db.Char(64)
  entryHash         String              @unique @db.Char(64)
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, kind, occurredAt])
  @@map("verification_audit_logs")
}

model PublicationOrder {
  id               String               @id @default(uuid()) @db.Uuid
  listingId        String               @db.Uuid
  userId           String               @db.Uuid
  package          PublicationPackage
  status           OrderStatus          @default(CREATED)
  amountCents      BigInt
  currency         String               @default("EUR") @db.Char(3)
  paymentProvider  String?
  paymentReference String?              @unique
  paidAt           DateTime?
  consumedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  listing          Listing              @relation(fields: [listingId], references: [id], onDelete: Restrict)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  publications     ListingPublication[]

  @@index([listingId, status])
  @@index([userId, createdAt])
  @@map("publication_orders")
}

model ListingPublication {
  id                  String              @id @default(uuid()) @db.Uuid
  listingId           String              @db.Uuid
  orderId             String?             @db.Uuid
  idempotencyKey      String              @unique
  channel             PublicationChannel
  status              PublicationStatus   @default(QUEUED)
  package             PublicationPackage?
  externalReference   String?
  requestPayloadHash  String?             @db.Char(64)
  responsePayloadHash String?             @db.Char(64)
  submittedAt         DateTime?
  liveAt              DateTime?
  failedAt            DateTime?
  failureCode         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  listing             Listing             @relation(fields: [listingId], references: [id], onDelete: Restrict)
  order               PublicationOrder?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([channel, externalReference])
  @@index([listingId, channel, status])
  @@map("listing_publications")
}

// Bid rows and events are append-only. PostgreSQL triggers in immutability.sql enforce this.
model Bid {
  id                    String     @id @default(uuid()) @db.Uuid
  listingId             String     @db.Uuid
  bidderUserId          String?    @db.Uuid
  idempotencyKey        String     @unique
  bidderPseudonym       String
  amountCents           BigInt
  currency              String     @default("EUR") @db.Char(3)
  resolutiveConditions  Json
  financingDeadline     DateTime?
  transferDateRequested DateTime?
  submittedAt           DateTime   @default(now())
  sourceIpHash          String?    @db.Char(64)
  previousHash          String?    @db.Char(64)
  entryHash             String     @unique @db.Char(64)
  listing               Listing    @relation(fields: [listingId], references: [id], onDelete: Restrict)
  bidderUser            User?      @relation(fields: [bidderUserId], references: [id], onDelete: SetNull)
  events                BidEvent[]
  transaction           PropertyTransaction?

  @@index([listingId, submittedAt])
  @@index([bidderUserId])
  @@map("bids")
}

model BidEvent {
  id           String       @id @default(uuid()) @db.Uuid
  bidId        String       @db.Uuid
  type         BidEventType
  reason       String?
  occurredAt   DateTime     @default(now())
  previousHash String?      @db.Char(64)
  entryHash    String       @unique @db.Char(64)
  bid          Bid          @relation(fields: [bidId], references: [id], onDelete: Restrict)

  @@index([bidId, occurredAt])
  @@map("bid_events")
}

model BidLogbookExport {
  id                   String    @id @default(uuid()) @db.Uuid
  listingId            String    @db.Uuid
  storageKey           String    @unique
  documentSha256       String    @db.Char(64)
  logbookHeadHash      String    @db.Char(64)
  anonymizationVersion String
  generatedAt          DateTime  @default(now())
  sharedAt             DateTime?
  recipientCount       Int       @default(0)
  listing              Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId, generatedAt])
  @@map("bid_logbook_exports")
}

model PropertyTransaction {
  id                        String            @id @default(uuid()) @db.Uuid
  listingId                 String            @db.Uuid
  acceptedBidId             String            @unique @db.Uuid
  sellerUserId              String            @db.Uuid
  buyerUserId               String            @db.Uuid
  status                    TransactionStatus @default(ACTIVE)
  purchasePriceCents        BigInt
  currency                  String            @default("EUR") @db.Char(3)
  targetTransferDate        DateTime?
  contractTerms             Json?
  buyerContractConfirmedAt  DateTime?
  sellerContractConfirmedAt DateTime?
  coolingOffEndsAt          DateTime?
  notaryDetails             Json?
  handoverDetails           Json?
  completedAt               DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?
  version                   Int               @default(1)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  listing                   Listing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  acceptedBid               Bid               @relation(fields: [acceptedBidId], references: [id], onDelete: Restrict)
  seller                    User              @relation("TransactionSeller", fields: [sellerUserId], references: [id], onDelete: Restrict)
  buyer                     User              @relation("TransactionBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  milestones                TransactionMilestone[]
  messages                  TransactionMessage[]
  documents                 TransactionDocument[]
  events                    TransactionEvent[]

  @@index([sellerUserId, status, updatedAt])
  @@index([buyerUserId, status, updatedAt])
  @@index([listingId, status])
  @@map("property_transactions")
}

model TransactionMilestone {
  id            String                       @id @default(uuid()) @db.Uuid
  transactionId String                       @db.Uuid
  type          TransactionMilestoneType
  status        TransactionMilestoneStatus   @default(NOT_STARTED)
  title         String
  dueAt         DateTime?
  completedAt   DateTime?
  details       Json?
  sortOrder     Int                          @default(0)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  transaction   PropertyTransaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, type])
  @@index([transactionId, sortOrder])
  @@index([dueAt, status])
  @@map("transaction_milestones")
}

model TransactionMessage {
  id            String                 @id @default(uuid()) @db.Uuid
  transactionId String                 @db.Uuid
  authorUserId  String                 @db.Uuid
  kind          TransactionMessageKind @default(TEXT)
  body          String
  createdAt     DateTime               @default(now())
  editedAt      DateTime?
  transaction   PropertyTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  author        User                   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  documents     TransactionDocument[]

  @@index([transactionId, createdAt])
  @@index([authorUserId, createdAt])
  @@map("transaction_messages")
}

model TransactionDocument {
  id            String                      @id @default(uuid()) @db.Uuid
  transactionId String                      @db.Uuid
  messageId     String?                     @db.Uuid
  uploadedById  String                      @db.Uuid
  category      TransactionDocumentCategory @default(OTHER)
  status        TransactionDocumentStatus   @default(AVAILABLE)
  storageKey    String                      @unique
  mimeType      String
  sha256        String                      @db.Char(64)
  fileName      String
  sizeBytes     BigInt
  version       Int                         @default(1)
  createdAt     DateTime                    @default(now())
  transaction   PropertyTransaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  message       TransactionMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy    User                        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([transactionId, category, createdAt])
  @@index([messageId])
  @@map("transaction_documents")
}

model PropertyPassportVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  listingId            String   @db.Uuid
  version              Int
  listingVersionSource Int
  snapshot             Json
  completenessScore    Int
  previousHash         String?  @db.Char(64)
  entryHash            String   @unique @db.Char(64)
  createdByUserId      String   @db.Uuid
  createdAt            DateTime @default(now())
  listing              Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  createdBy            User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([listingId, version])
  @@index([listingId, createdAt])
  @@map("property_passport_versions")
}

model TransactionEvent {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @db.Uuid
  actorUserId   String?              @db.Uuid
  type          TransactionEventType
  payload       Json?
  occurredAt    DateTime             @default(now())
  previousHash  String?              @db.Char(64)
  entryHash     String               @unique @db.Char(64)
  transaction   PropertyTransaction  @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  actor         User?                @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([transactionId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("transaction_events")
}

model FavoriteListing {
  id                 String        @id @default(uuid()) @db.Uuid
  userId             String        @db.Uuid
  listingId          String        @db.Uuid
  note               String?
  priceSnapshotCents BigInt?
  statusSnapshot     ListingStatus
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing            Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, updatedAt])
  @@index([listingId])
  @@map("favorite_listings")
}

model SavedSearch {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  name                 String
  queryString          String
  notificationsEnabled Boolean  @default(true)
  lastCheckedAt        DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@unique([userId, queryString])
  @@map("saved_searches")
}

model NotificationPreference {
  userId              String   @id @db.Uuid
  newListing          Boolean  @default(true)
  priceChange         Boolean  @default(true)
  statusChange        Boolean  @default(true)
  viewing             Boolean  @default(true)
  bid                 Boolean  @default(true)
  transaction         Boolean  @default(true)
  deadline            Boolean  @default(true)
  inAppEnabled        Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model SeekerNotification {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @db.Uuid
  type      SeekerNotificationType
  eventKey  String
  title     String
  body      String
  href      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime               @default(now())
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
  @@map("seeker_notifications")
}

model ShortlistShare {
  id        String          @id @default(uuid()) @db.Uuid
  ownerId   String          @db.Uuid
  label     String?
  tokenHash String          @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime        @default(now())
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     ShortlistItem[]

  @@index([ownerId, createdAt])
  @@index([expiresAt, revokedAt])
  @@map("shortlist_shares")
}

model ShortlistItem {
  id        String         @id @default(uuid()) @db.Uuid
  shareId   String         @db.Uuid
  listingId String         @db.Uuid
  note      String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  share     ShortlistShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  listing   Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([shareId, listingId])
  @@index([shareId, sortOrder])
  @@index([listingId])
  @@map("shortlist_items")
}

model EstimateCache {
  id                    String       @id @default(uuid()) @db.Uuid
  inputHash             String       @unique @db.Char(64)
  normalizedInput       Json
  qualitativeFeatures   Json?
  imageHashes           Json?
  tier                  EstimateTier
  estimatedValueCents   BigInt
  lowerBoundCents       BigInt
  upperBoundCents       BigInt
  confidenceBasisPoints Int
  llmModelVersion       String?
  mlModelVersion        String?
  publicDatasetVersion  String?
  explanation           Json?
  createdAt             DateTime     @default(now())
  expiresAt             DateTime?

  @@index([expiresAt])
  @@map("estimate_cache")
}

model PostcodePriceStat {
  id                      String       @id @default(uuid()) @db.Uuid
  postcodeSector          String
  propertyType            PropertyType
  averagePricePerSqmCents BigInt
  sampleSize              Int
  source                  String
  datasetVersion          String
  effectiveAt             DateTime
  createdAt               DateTime     @default(now())

  @@unique([postcodeSector, propertyType, datasetVersion])
  @@index([postcodeSector, effectiveAt])
  @@map("postcode_price_stats")
}

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @db.Uuid
  listingId     String?  @db.Uuid
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  occurredAt    DateTime @default(now())
  requestId     String?
  previousHash  String?  @db.Char(64)
  entryHash     String   @unique @db.Char(64)
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([aggregateType, aggregateId, occurredAt])
  @@index([listingId, occurredAt])
  @@map("audit_events")
}
