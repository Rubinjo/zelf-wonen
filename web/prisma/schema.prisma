// --- Inbound aggregator ------------------------------------------------------
// A single master record per property, deduplicated across Funda/Kamernet by
// address (postcode + house number OR street + house number). Owned by the
// Python aggregator cron service; the web app only reads these rows.

model AggregatedListing {
  id                   String                    @id @default(uuid()) @db.Uuid
  // Canonical dedup key (postcode+house preferred, else street+house).
  dedupKey             String                    @unique @map("dedup_key")
  // Secondary lookup keys so a source that only has a street still merges with
  // a source that only has a postcode.
  postcodeHouseKey     String?                   @map("postcode_house_key")
  streetHouseKey       String?                   @map("street_house_key")

  purpose              ListingPurpose
  status               AggregatedListingStatus   @default(ACTIVE)
  publicSlug           String                    @unique @map("public_slug")
  titleNl              String?                   @map("title_nl")
  descriptionNl        String?                   @map("description_nl")

  askingPriceCents     BigInt?                   @map("asking_price_cents")
  monthlyRentCents     BigInt?                   @map("monthly_rent_cents")
  serviceCostsCents    BigInt?                   @map("service_costs_cents")

  postcode             String?                   @db.VarChar(7)
  houseNumber          Int                       @map("house_number")
  houseNumberAddition  String?                   @map("house_number_addition")
  street               String
  city                 String
  municipality         String?
  province             String?
  latitude             Decimal?                  @db.Decimal(9, 6)
  longitude            Decimal?                  @db.Decimal(9, 6)

  propertyType         PropertyType              @map("property_type")
  livingAreaSqm        Decimal?                  @db.Decimal(8, 2) @map("living_area_sqm")
  plotAreaSqm          Decimal?                  @db.Decimal(10, 2) @map("plot_area_sqm")
  volumeCubicMeters    Decimal?                  @db.Decimal(10, 2) @map("volume_cubic_meters")
  roomCount            Int?                      @map("room_count")
  bedroomCount         Int?                      @map("bedroom_count")
  bathroomCount        Int?                      @map("bathroom_count")
  constructionYear     Int?                      @map("construction_year")
  energyLabel          EnergyLabelClass?         @map("energy_label")

  interior             Json?                     @map("interior")
  amenities            String[]                  @default([])
  availableFrom        DateTime?                 @map("available_from")

  summaryHash          String?                   @db.Char(64) @map("summary_hash")
  firstSeenAt          DateTime                  @default(now()) @map("first_seen_at")
  lastSeenAt           DateTime                  @map("last_seen_at")
  expiredAt            DateTime?                 @map("expired_at")
  lastSyncAt           DateTime                  @default(now()) @map("last_sync_at")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  platformLinks        AggregatedPlatformLink[]
  images               AggregatedListingImage[]
  rawPayloads          RawPayload[]

  @@index([status, lastSyncAt])
  @@index([postcodeHouseKey])
  @@index([streetHouseKey])
  @@index([city])
  @@map("aggregated_listings")
}

model AggregatedPlatformLink {
  id          String                    @id @default(uuid()) @db.Uuid
  listingId   String                    @db.Uuid @map("listing_id")
  source      ListingSource
  externalId  String                    @map("external_id")
  url         String
  status      AggregatedListingStatus   @default(ACTIVE)
  summaryHash String?                   @db.Char(64) @map("summary_hash")
  firstSeenAt DateTime                  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime                  @map("last_seen_at")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  listing     AggregatedListing         @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([listingId, source])
  @@map("aggregated_platform_links")
}

model AggregatedListingImage {
  id         String             @id @default(uuid()) @db.Uuid
  listingId  String             @db.Uuid @map("listing_id")
  storageKey String             @unique @map("storage_key")
  sourceUrl  String             @map("source_url")
  mimeType   String             @map("mime_type")
  sha256     String             @db.Char(64)
  width      Int?
  height     Int?
  sortOrder  Int                @default(0) @map("sort_order")
  createdAt  DateTime           @default(now()) @map("created_at")
  listing    AggregatedListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@map("aggregated_listing_images")
}

// Raw HTML/JSON responses kept for debugging. Never pruned automatically.
model RawPayload {
  id          String             @id @default(uuid()) @db.Uuid
  source      ListingSource
  externalId  String             @map("external_id")
  kind        String             // summary | detail | sitemap
  url         String?
  httpStatus  Int?               @map("http_status")
  contentType String?            @map("content_type")
  contentHash String             @db.Char(64) @map("content_hash")
  body        String             @db.Text
  bytes       Int?
  listingId   String?            @db.Uuid @map("listing_id")
  retrievedAt DateTime           @default(now()) @map("retrieved_at")
  listing     AggregatedListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([source, externalId, retrievedAt])
  @@index([listingId])
  @@map("raw_payloads")
}
