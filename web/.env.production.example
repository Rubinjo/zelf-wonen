# Copy to .env.production; never commit the populated file.
# Separate production volumes/containers from the local development stack.
COMPOSE_PROJECT_NAME=zelfwonen-production
# Hostname only: no scheme, path, or port. Point its DNS at the VPS.
APP_DOMAIN=
# Use a URL-safe password, e.g. openssl rand -hex 32.
POSTGRES_PASSWORD=

# Application and Better Auth
NEXT_PUBLIC_APP_URL=https://${APP_DOMAIN}
BETTER_AUTH_URL=https://${APP_DOMAIN}
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://zelfwonen:${POSTGRES_PASSWORD}@postgres:5432/zelfwonen?schema=public

# Brevo verification email delivery (TOKEN must be an API key, not an SMTP key)
NEXT_PUBLIC_EMAIL_DELIVERY_MODE=webhook
EMAIL_DELIVERY_WEBHOOK_URL=https://api.brevo.com/v3/smtp/email
EMAIL_DELIVERY_TOKEN=
EMAIL_FROM_NAME="Redaxa Support"
EMAIL_FROM_ADDRESS=support@redaxa.nl

# OpenRouter (Vercel AI SDK via @openrouter/ai-sdk-provider; Auto Router "openrouter/auto")
OPENROUTER_API_KEY=

# Deterministic Python estimator
ML_ESTIMATOR_URL=http://estimator:8000
ML_ESTIMATOR_TOKEN=

# Media uses persistent VM volumes; no object storage account is required.
# The estimator reads authorized photo bytes directly; no media base URL is needed.

# Inbound aggregator images (platform-controlled storage / CDN domain)
AGGREGATED_MEDIA_BASE_URL=/aggregated-media
# Production starts the worker automatically: immediate import, then every 24h.
AGGREGATOR_SYNC_INTERVAL_SECONDS=86400
AGGREGATOR_ENABLED_SOURCES=FUNDA,KAMERNET
# Browser-compatible TLS/HTTP transport; no Chrome installation is required.
AGGREGATOR_FUNDA_TRANSPORT=chrome
AGGREGATOR_MAX_LISTINGS_PER_SOURCE=100000
AGGREGATOR_POLITE_DELAY_SECONDS=5
AGGREGATOR_DISCOVERY_PAGE_BATCH_SIZE=20
AGGREGATOR_DETAIL_BATCH_SIZE=500
AGGREGATOR_MAX_IMAGES_PER_LISTING=50
AGGREGATOR_SOURCE_TIMEOUT_SECONDS=14400
AGGREGATOR_SOURCE_COOLDOWN_SECONDS=21600
# Public search adapters never expire listings based on absence.
AGGREGATOR_EXPIRE_MISSING=false
# Remove historical discovery URL overrides; these old endpoints return 404.
AGGREGATOR_FUNDA_SITEMAP_URL=
AGGREGATOR_KAMERNET_SEARCH_URL=
# Optional pipe-separated public search URLs can scope collection geographically.
# Defaults cover Funda buy/rent and Kamernet rooms/apartments/studios nationally.
# Set AGGREGATOR_FUNDA_SEARCH_URLS and AGGREGATOR_KAMERNET_SEARCH_URLS to override.

# Property-data lookups

# Best-effort public single-address energy-label lookup
ENERGIELABEL_NL_API_BASE_URL=https://www.energielabel.nl/api/v1/

# Didit identity verification; use a dedicated workspace and the free KYC workflow.
# Configure https://YOUR_DOMAIN/api/identity/didit/webhook in Didit's console.
# The server permits at most 499 monthly reservations, including unfinished carryover.
IDENTITY_VERIFICATION_TTL_DAYS=365
DIDIT_MODE=live
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=


# Audit/privacy salts
IP_HASH_SALT=

# Owner-only admin dashboard (users.id of your verified account; takes precedence over ADMIN_EMAIL)
ADMIN_USER_ID=
# Alternative: verified email address of the owner
ADMIN_EMAIL=
