# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/web/node_modules
/web/.pnp
/web/.pnp.*
/web/.yarn/*
!/web/.yarn/patches
!/web/.yarn/plugins
!/web/.yarn/releases
!/web/.yarn/versions
/estimator/.venv/
/aggregator/.venv/

# testing
/web/coverage
/estimator/.coverage
/estimator/.pytest_cache/
/aggregator/.pytest_cache/

# next.js
/web/.next/
/web/out/

# production
/web/build

# python
__pycache__/
*.py[cod]
/estimator/.ruff_cache/
/aggregator/.ruff_cache/

# aggregator runtime data (local re-hosted images land under web/public)
/aggregator/.data/
/web/public/aggregated-media/

# web runtime file storage (seeded/generated/uploaded transaction docs & bid logbooks)
/web/.data/
/web/public/uploads/
/web/.backups/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.maintenance.lock
.state/
